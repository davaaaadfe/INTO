# Public app URL. Vercel can auto-derive this, but explicit is clearer.
APP_URL=https://your-vercel-domain.vercel.app

# Shared company Exact Online OAuth app. Local development: put these values in .env or .env.local. Vercel: add them in Project Settings > Environment Variables.
EXACT_ONLINE_MODE=real
# Must be the Exact OAuth app Client ID, not an email address.
EXACT_ONLINE_CLIENT_ID=
# Exact OAuth app Client Secret. Never use or store an Exact username/password.
EXACT_ONLINE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Exact OAuth app.
EXACT_ONLINE_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/exact/callback
EXACT_ONLINE_BASE_URL=https://start.exactonline.nl
EXACT_ONLINE_ENABLE_REAL_BOOKING=false

# Server-side secrets. Use long random values and never expose them publicly. OAuth tokens are encrypted with OAUTH_TOKEN_ENCRYPTION_KEY.
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Durable production records. Required for Vercel production.
# Use Vercel Postgres, Neon, Supabase, or another managed PostgreSQL database.
DATABASE_URL=

# Temporary invoice file storage. Files are kept while processing/reviewing
# and deleted after successful Exact booking.
STORAGE_MODE=local_temp
TEMP_INVOICE_STORAGE_PATH=storage/tmp-invoices
TEMP_INVOICE_RETENTION_DAYS=30

# Show detailed system-owner setup diagnostics. Keep off for normal users.
SHOW_SYSTEM_SETUP=false
