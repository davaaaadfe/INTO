# Public app URL. Vercel can auto-derive this, but explicit is clearer.
APP_URL=https://your-vercel-domain.vercel.app

# Shared company Exact Online OAuth app.
EXACT_ONLINE_MODE=real
EXACT_ONLINE_CLIENT_ID=
EXACT_ONLINE_CLIENT_SECRET=
EXACT_ONLINE_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/exact/callback
EXACT_ONLINE_BASE_URL=https://start.exactonline.nl
EXACT_ONLINE_ENABLE_REAL_BOOKING=false

# Shared company Microsoft Outlook OAuth app.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://your-vercel-domain.vercel.app/api/outlook/callback

# Server-side secrets. Use long random values and never expose them publicly.
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Database-free mode:
# DATABASE_URL is optional and not required.

# Durable invoice file storage for Vercel production.
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
