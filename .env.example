# Local app URL. For real Exact OAuth, use the public HTTPS URL that forwards
# to this local server so the callback exactly matches the Exact app setting.
APP_URL=http://localhost:3000

# Shared password required before anyone can open INTO. Set this only on the server.
INTO_ACCESS_PASSWORD=

# Shared company Exact Online OAuth app. Local development: put these values in .env or .env.local. Vercel: add them in Project Settings > Environment Variables.
EXACT_ONLINE_MODE=real
# Must be the Exact OAuth app Client ID, not an email address.
EXACT_ONLINE_CLIENT_ID=
# Exact OAuth app Client Secret. Never use or store an Exact username/password.
EXACT_ONLINE_CLIENT_SECRET=
# Must exactly match the redirect URI registered in the Exact OAuth app.
EXACT_ONLINE_REDIRECT_URI=https://your-public-local-url/api/exact/callback
EXACT_ONLINE_BASE_URL=https://start.exactonline.nl
EXACT_ONLINE_ENABLE_REAL_BOOKING=false
EXACT_ONLINE_DOCUMENT_TYPE=55

# Server-side secrets. Use long random values and never expose them publicly. OAuth tokens are encrypted with OAUTH_TOKEN_ENCRYPTION_KEY.
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_SECRET=

# Supplier learning is disabled by default in production. Enable each rollout
# surface independently after migration, privacy, and held-out precision checks.
LEARNING_V2_ENABLED=false
LEARNING_UI_ENABLED=false
SUPPLIER_RESOLUTION_V2_ENABLED=false
LEARNING_SHADOW_MODE=true
SUPPLIER_LEARNING_MODE=off

# Dedicated AES-GCM key for minimized OCR/layout learning artifacts. Do not
# reuse the OAuth key. Generate a separate long random value.
LEARNING_ARTIFACT_ENCRYPTION_KEY=
# Encrypted OCR/layout evidence retention. Defaults to 365 days (range 1-3650).
LEARNING_ARTIFACT_RETENTION_DAYS=365

# Optional managed OCR. It remains off unless both the feature flag and these
# server-side settings are present. Never expose the API key to the browser.
DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL_ID=prebuilt-invoice
DOCUMENT_INTELLIGENCE_TIMEOUT_MS=20000

# Durable local records. SQLite is the default outside Vercel.
DATABASE_MODE=sqlite
LOCAL_DATABASE_PATH=data/into.sqlite

# Local invoice files are kept while processing/reviewing and deleted only
# after a successful Exact booking with its attachment.
STORAGE_MODE=local
TEMP_INVOICE_STORAGE_PATH=storage/invoices
TEMP_INVOICE_RETENTION_DAYS=30

# Optional only when deploying to Vercel instead of running locally.
DATABASE_URL=

# Show detailed system-owner setup diagnostics. Keep off for normal users.
SHOW_SYSTEM_SETUP=false
